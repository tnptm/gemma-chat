# Required, at least 32 characters. Use the same value in backend/.env.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
OLLAMA_AGENT_API_KEY=
# Loopback only, e.g. 127.0.0.1:11435
OLLAMA_AGENT_BIND=127.0.0.1:11435
# Ollama executable on the host (name on PATH or absolute path)
OLLAMA_BIN=ollama
# Where the state file and ollama.log are kept (default: ollama-agent/run)
# OLLAMA_AGENT_RUN_DIR=
