DJANGO_DEBUG=1
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public origin(s) of the Next.js app (needed for CSRF origin checks)
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Set to 1 when served over HTTPS (default: 1 when DEBUG=0)
COOKIE_SECURE=0
# SQLite file location (default: backend/db.sqlite3). docker compose sets /app/data/db.sqlite3.
# SQLITE_PATH=
# Ollama control agent on the host (see ollama-agent/). Same key as in ollama-agent/.env
OLLAMA_AGENT_URL=http://127.0.0.1:11435
OLLAMA_AGENT_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
# Check the exact tag with: ollama list
OLLAMA_MODEL=gemma4
CHAT_SYSTEM_PROMPT=You are a helpful assistant.
CHAT_HISTORY_LIMIT=40
